    "@picocss/pico": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
